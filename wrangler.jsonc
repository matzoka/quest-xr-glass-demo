{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/schemas/config.schema.json",
  "name": "quest-xr-glass-demo",
  "main": "worker/index.js",
  "compatibility_date": "2024-12-01",
  "workers_dev": true,

  // Static assets configuration
  // The Worker runs first for all requests to handle authentication
  // Static files are in the public/ directory
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // v23: Workers AI (Whisper speech-to-text for /api/stt)
  "ai": {
    "binding": "AI"
  },

  // v26: taxi analytics data (trips / vocab / meta). Schema: migrations/, data: scripts/import-trips.mjs
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taxi-analytics",
      "database_id": "3af31fba-c33d-4ebd-b251-b4bdf62f8b5b",
      "migrations_dir": "migrations"
    }
  ]
}
